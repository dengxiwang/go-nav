{
  "name": "go-nav",
  "version": "2.1.1",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "dev": "next dev",
    "dev:static": "BUILD_MODE=static next dev",
    "build": "pnpm run build:server",
    "build:server": "BUILD_MODE=server next build --webpack && node scripts/copy-standalone-assets.mjs",
    "build:static": "BUILD_MODE=static node scripts/sync-uploads.mjs && BUILD_MODE=static next build --webpack && node -e \"const fs=require('fs'),p=require('path');const d=p.join(process.cwd(),'public','uploads');if(fs.existsSync(d))fs.rmSync(d,{recursive:true,force:true});console.log('[build:static] 已清理 public/uploads/')\"",
    "build:html": "BUILD_MODE=html node scripts/sync-uploads.mjs && BUILD_MODE=html next build --webpack && BUILD_MODE=html node scripts/finalize-html-build.mjs",
    "preview:html": "node scripts/html-preview-server.mjs web",
    "start": "node .next/standalone/server.js",
    "lint": "eslint",
    "docker:build": "sh scripts/docker-build.sh",
    "docker:up": "docker compose up -d --build",
    "docker:logs": "docker compose logs -f",
    "docker:down": "docker compose down",
    "docker:run": "docker run --rm -p 3000:3000 -e ADMIN_USER=admin -e ADMIN_PASS=admin123 -v \"$PWD/go-nav-data:/app/data\" go-nav:latest",
    "docker:push": "sh scripts/docker-push.sh"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.6",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@gravity-ui/icons": "^2.21.0",
    "@heroui/react": "^3.2.2",
    "@heroui/styles": "^3.2.2",
    "@iconify/react": "^6.0.2",
    "@uiw/react-codemirror": "^4.25.11",
    "babel-plugin-react-compiler": "^1.0.0",
    "fetch-jsonp": "^1.4.0",
    "fflate": "^0.8.3",
    "jotai": "^2.20.2",
    "jotai-family": "^1.0.2",
    "next": "16.3.0-canary.26",
    "pinyin-pro": "^3.28.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-icons": "^5.7.0",
    "react-sortablejs": "^6.1.4",
    "sharp": "^0.35.3",
    "sortablejs": "^1.15.7",
    "swiper": "^14.0.6",
    "terser-webpack-plugin": "^5.6.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sortablejs": "^1.15.9",
    "cross-env": "^10.1.0",
    "eslint": "^10",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "typescript": "^6"
  }
}
